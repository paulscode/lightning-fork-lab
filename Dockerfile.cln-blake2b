# Core Lightning on the Bitcoin BLAKE2b chain: the privkeyio port (header
# parsing) plus the chain-identity patch series kept in the fork repository
# (contrib/cln-chain-identity), built from source. The patches are
# copied into build/cln-patches by `make cln`.
FROM ubuntu:24.04 AS builder
ARG CLN_REPO=https://github.com/privkeyio/lightning
# v26.06.7-blake2b.3, pinned by commit rather than by tag.
ARG CLN_REF=c6d386ffac2b8465d918be24a8aa9a626e051a41
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        autoconf automake build-essential git libtool libsqlite3-dev \
        python3 python3-pip python3-mako net-tools zlib1g-dev libsodium-dev \
        gettext protobuf-compiler jq pkg-config libpq-dev ca-certificates lowdown \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --break-system-packages uv
RUN git clone "$CLN_REPO" /src && git -C /src checkout -q "$CLN_REF"
WORKDIR /src
COPY build/cln-patches/ /patches/
RUN git config user.email lab@example.invalid && git config user.name lab \
    && git am /patches/*.patch \
    && ./configure --disable-rust --disable-valgrind \
    && make -j"$(nproc)" \
    && make install DESTDIR=/out

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
        libsodium23 libsqlite3-0 libpq5 zlib1g ca-certificates jq curl python3 \
        libevent-2.1-7 libevent-pthreads-2.1-7 libevent-extra-2.1-7 \
    && rm -rf /var/lib/apt/lists/*
# The bcli plugin drives bitcoind through bitcoin-cli; Knots' knows the chain.
# Extracted from the lab's Knots image by `make cln` (a COPY --from a local
# image is not something BuildKit resolves).
COPY build/bitcoin-cli /usr/local/bin/bitcoin-cli
COPY --from=builder /out/usr/local/ /usr/local/
RUN lightningd --version && bitcoin-cli --version | head -1
VOLUME /data
EXPOSE 9735
ENTRYPOINT ["lightningd"]
