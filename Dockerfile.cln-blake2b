# Core Lightning on the Bitcoin BLAKE2b chain: the privkeyio port, built from
# source. The chain-identity series kept in the fork repository
# (contrib/cln-chain-identity) has landed upstream, so nothing is applied.
FROM ubuntu:24.04 AS builder
ARG CLN_REPO=https://github.com/privkeyio/lightning
# blake2b-unified after the flag day, on v26.06.9: option_blake2b is 512 and
# option_unified_sigs 514. The previous pin, 24d02731, was the base the
# chain-identity series targeted and still advertised bit 68, so a current
# Lightning Fork hangs up on it.
ARG CLN_REF=c774ad19d1fa2b8d8b77914e13853e6f69f1f33f
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        autoconf automake build-essential git libtool libsqlite3-dev \
        python3 python3-pip python3-mako net-tools zlib1g-dev libsodium-dev \
        gettext protobuf-compiler jq pkg-config libpq-dev ca-certificates lowdown \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --break-system-packages uv grpcio-tools
# grpcio-tools because the chain-identity series edits cln-grpc/proto/node.proto,
# and git am does not promise to write a .proto before the stubs generated from
# it, so make sometimes decides they are stale and regenerates them.
RUN git clone "$CLN_REPO" /src && git -C /src checkout -q "$CLN_REF"
WORKDIR /src
RUN ./configure --disable-rust --disable-valgrind \
    && make -j"$(nproc)" \
    && make install DESTDIR=/out

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
        libsodium23 libsqlite3-0 libpq5 zlib1g ca-certificates jq curl python3 \
        libevent-2.1-7 libevent-pthreads-2.1-7 libevent-extra-2.1-7 \
    && rm -rf /var/lib/apt/lists/*
# The bcli plugin drives bitcoind through bitcoin-cli; Knots' knows the chain.
# Extracted from the lab's Knots image by `make cln` (a COPY --from a local
# image is not something BuildKit resolves).
COPY build/bitcoin-cli /usr/local/bin/bitcoin-cli
COPY --from=builder /out/usr/local/ /usr/local/
RUN lightningd --version && bitcoin-cli --version | head -1
VOLUME /data
EXPOSE 9735
ENTRYPOINT ["lightningd"]
