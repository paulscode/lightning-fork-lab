# A runnable Core Lightning node on blake2b-unified, so that interop with
# Lightning Fork can be tried rather than reasoned about.
#
# PATCHDIR selects what is applied on top of upstream/blake2b-unified:
#   build/cln-patches-unified   the chain-identity series as proposed (14)
#   build/cln-patches-expt68    the same, plus one experiment that advertises
#                               option_blake2b as optional in init (15)
#
# The two images differ by one word in common/features.c. Everything else
# about them, including the base commit, is identical, which is the point:
# whatever differs in the result is caused by that word.
FROM ubuntu:24.04 AS builder
ARG CLN_REPO=https://github.com/privkeyio/lightning
# blake2b-unified @ 24d027310 "connectd: stop requiring peers to advertise
# blake2b bit 68", pinned by commit rather than by branch name.
ARG CLN_REF=24d0273100c75eac99e0400f767267efde4b012c
ARG PATCHDIR=build/cln-patches-unified
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        autoconf automake build-essential git libtool libsqlite3-dev \
        python3 python3-pip python3-mako net-tools zlib1g-dev libsodium-dev \
        gettext protobuf-compiler jq pkg-config libpq-dev ca-certificates lowdown \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --break-system-packages uv grpcio-tools
RUN git clone "$CLN_REPO" /src && git -C /src checkout -q "$CLN_REF"
WORKDIR /src
COPY ${PATCHDIR}/ /patches/
RUN git config user.email lab@example.invalid && git config user.name lab \
    && git am /patches/*.patch \
    && ./configure --disable-rust --disable-valgrind \
    && make -j"$(nproc)" \
    && make install DESTDIR=/out

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
        libsodium23 libsqlite3-0 libpq5 zlib1g ca-certificates jq curl python3 \
        libevent-2.1-7 libevent-pthreads-2.1-7 libevent-extra-2.1-7 \
    && rm -rf /var/lib/apt/lists/*
COPY build/bitcoin-cli /usr/local/bin/bitcoin-cli
COPY --from=builder /out/usr/local/ /usr/local/
RUN lightningd --version && bitcoin-cli --version | head -1
VOLUME /data
EXPOSE 9735
ENTRYPOINT ["lightningd"]
